{
  "name": "skinova-discord-activity",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "Skinova Discord Activity V1.4.2",
  "scripts": {
    "dev": "concurrently -k -n CLIENT,SERVER -c cyan,magenta \"vite --host 0.0.0.0\" \"node --watch server/index.js\"",
    "build": "vite build",
    "start": "node server/index.js",
    "demo": "npm run build && npm start",
    "register": "node scripts/register-commands.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "^7.1.3"
  }
}
